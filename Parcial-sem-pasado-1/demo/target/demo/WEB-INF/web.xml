<!DOCTYPE web-app PUBLIC
 "-//Sun Microsystems, Inc.//DTD Web Application 2.3//EN"
 "http://java.sun.com/dtd/web-app_2_3.dtd" >

<web-app>
  <display-name>Demo Web Application</display-name>
  <!-- 1. Decirle a Spring que use la clase del contexto basada en anotaciones/Java -->
  <context-param>
    <param-name>contextClass</param-name>
    <param-value>org.springframework.web.context.support.AnnotationConfigWebApplicationContext</param-value>
  </context-param>
  <!-- 2. Especificar la clase Java de configuración (en lugar del archivo xml) -->
  <context-param>
    <param-name>contextConfigLocation</param-name>
    <param-value>com.parcial.config.AppConfig</param-value>
  </context-param>
  <!-- 3. El listener de Spring sigue exactamente igual -->
  <listener>
    <listener-class>
        org.springframework.web.context.ContextLoaderListener
    </listener-class>
  </listener>
</web-app>